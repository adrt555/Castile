generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Client {
  id             String   @id @default(uuid())
  name           String
  company        String
  email          String   @unique
  phone          String
  type           String   // 'Architect' | 'Designer' | 'Contractor' | 'Homeowner'
  totalSpent     Float    @default(0.0)
  createdAt      DateTime @default(now())
  address        String?
  billingAddress String?
  orders         Order[]
}

model Order {
  id              String      @id @default(uuid())
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status          String      // 'Quote' | 'Invoice Sent' | 'Paid' | 'Unfulfilled' | 'Delivered'
  subtotal        Float
  discount        Float?      @default(0.0)
  freight         Float?      @default(0.0)
  tax             Float
  total           Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  shippingAddress String?
  billingAddress  String?
  items           OrderItem[]
}

model OrderItem {
  id           String @id @default(uuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  colorName    String
  size         String
  quantitySqft Float
  unitPrice    Float
  totalPrice   Float
}

model Admin {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique
  manufacturer String
  status       String              // 'Pending' | 'Confirmed' | 'In Production' | 'Shipped' | 'Received'
  expectedDate String?
  notes        String?
  subtotal     Float
  freight      Float               @default(0.0)
  tax          Float               @default(0.0)
  total        Float
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id            String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku           String
  description   String
  boxes         Int
  sqftPerBox    Float
  unitCost      Float
  totalLineCost Float
}
