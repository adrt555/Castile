generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Client {
  id             String   @id @default(uuid())
  name           String
  company        String
  email          String   @unique
  phone          String
  type           String   // 'Architect' | 'Designer' | 'Contractor' | 'Homeowner'
  totalSpent     Float    @default(0.0)
  createdAt      DateTime @default(now())
  address           String?
  billingAddress    String?
  commissionCredits Float           @default(0.0)
  orders            Order[]
  projects          Project[]
  creditHistory     CreditHistory[]
}

model CreditHistory {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount    Float
  type      String   // 'ADD' | 'SUBTRACT'
  reason    String?
  createdAt DateTime @default(now())
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     Int         @unique @default(autoincrement())

  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status          String      // 'Quote' | 'Invoice Sent' | 'Paid' | 'Unfulfilled' | 'Delivered'
  subtotal        Float
  discount        Float?      @default(0.0)
  freight         Float?      @default(0.0)
  tax             Float
  total           Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  shippingAddress String?
  billingAddress  String?
  items           OrderItem[]
}

model OrderItem {
  id           String @id @default(uuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  colorName    String
  size         String
  quantitySqft Float
  unitPrice    Float
  totalPrice   Float
  room         String?
  unit         String @default("sqft") // "sqft" or "PC"
}

model Admin {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique
  manufacturer String
  status       String              // 'Pending' | 'Confirmed' | 'In Production' | 'Shipped' | 'Received'
  expectedDate String?
  notes        String?
  subtotal     Float
  freight      Float               @default(0.0)
  tax          Float               @default(0.0)
  total        Float
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id            String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku           String
  description   String
  boxes         Int
  sqftPerBox    Float
  unitCost      Float
  totalLineCost Float
}

model Project {
  id            String        @id @default(uuid())
  projectNumber Int           @unique @default(autoincrement())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String?
  address       String?
  status        String        @default("Draft") // 'Draft' | 'Sent' | 'Approved'
  total         Float         @default(0.0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  areas         ProjectArea[]
}

model ProjectArea {
  id        String        @id @default(uuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  phase     String
  items     ProjectItem[]
}

model ProjectItem {
  id          String      @id @default(uuid())
  areaId      String
  area        ProjectArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  code        String
  description String
  quantity    Float
  unit        String      @default("SQFT")
  unitPrice   Float
  totalPrice  Float
  imageUrl    String?
}

model ProductImage {
  sku       String   @id
  base64    String
  mimeType  String   @default("image/jpeg")
  updatedAt DateTime @updatedAt
}

model KitchenQuote {
  id                    String             @id @default(uuid())
  quoteNumber           Int                @unique @default(autoincrement())
  clientName            String
  clientEmail           String
  clientPhone           String
  projectAddress        String
  status                String             // 'Lead' | 'Measuring' | 'Design' | 'Quote Sent' | 'Approved' | 'In Production' | 'Installed' | 'Lost'
  style                 String?
  subtotal              Float
  discount              Float?             @default(0.0)
  tax                   Float
  installationFee       Float              @default(0.0)
  total                 Float
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  estimatedInstallDate  String?
  salesRep              String             @default("Adrian")
  items                 KitchenQuoteItem[]
}

model KitchenQuoteItem {
  id           String       @id @default(uuid())
  quoteId      String
  quote        KitchenQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  sku          String
  quantity     Float
  unit         String       @default("each")
  unitPrice    Float
  totalPrice   Float
  area         String?      // 'Kitchen' | 'Laundry' | 'Closet' | 'Bathroom'
  notes        String?
}